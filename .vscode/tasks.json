{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test Viewer: build signed release APK",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Build.ps1",
        "-Target",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PUB_CACHE": "${env:USERPROFILE}\\development\\pub-cache"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "detail": "Validates the project and builds an APK signed with the private release key."
    }
  ]
}
